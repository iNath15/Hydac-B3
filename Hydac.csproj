<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Stops Hydac from compiling anything inside the HydacUnitTest folder -->
		<Compile Remove="HydacUnitTest\**" />
		<EmbeddedResource Remove="HydacUnitTest\**" />
		<None Remove="HydacUnitTest\**" />
	</ItemGroup>

</Project>